					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="f_mea_afm" nillable="false">
				<xs:annotation>
					<xs:documentation>Α.Φ.Μ. ΩΦΕΛΟΥΜΕΝΟΥ</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="([0-9]){9}" />
						<xs:length value="9" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="f_diakoph_date">
				<xs:annotation>
					<xs:documentation>ΗΜΕΡΟΜΗΝΙΑ ΔΙΑΚΟΠΗΣ ΠΡΑΚΤΙΚΗΣ ΑΣΚΗΣΗΣ</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
