			<!-- END Ε13 -->
			<xs:element name="Mixanes" type="MixanesE13Type">
				<xs:annotation>
					<xs:documentation>ΣΤΟΙΧΕΙΑ ΜΗΧΑΝΗΣ/ΩΝ</xs:documentation>
