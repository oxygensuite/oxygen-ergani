<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns="http://www.yeka.gr/E31D" xml:lang="gr" attributeFormDefault="unqualified" targetNamespace="http://www.yeka.gr/E31D" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:complexType name="AnaggeliaE31DType">
