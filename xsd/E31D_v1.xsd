			<xs:element name="f_aa_pararthmatos" nillable="false">
				<xs:annotation>
					<xs:documentation>Α/Α ΠΑΡΑΡΤΗΜΑΤΟΣ</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[0-9]{1,5}" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="f_protocol_sx">
